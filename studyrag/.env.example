# Required
GROQ_API_KEY=your_groq_api_key_here

# Optional
GROQ_MODEL=llama-3.3-70b-versatile
EMBED_MODEL=BAAI/bge-small-en-v1.5
HOST=0.0.0.0
PORT=7860

# Storage
UPLOAD_DIR=uploads
CHROMA_DIR=chroma_store

# Limits
MAX_FILE_SIZE=20971520
